{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ecom-workflow.local/schemas/order.schema.json",
  "title": "Order",
  "description": "Normalized multi-platform order for ingest, tracking, and returns.",
  "type": "object",
  "required": [
    "order_id",
    "correlation_id",
    "store_id",
    "platform",
    "external_order_id",
    "status",
    "created_at"
  ],
  "properties": {
    "order_id": { "type": "string", "format": "uuid" },
    "correlation_id": { "type": "string", "format": "uuid" },
    "store_id": { "type": "string" },
    "platform": {
      "type": "string",
      "enum": ["shopify", "woocommerce", "amazon", "other"]
    },
    "external_order_id": { "type": "string" },
    "status": { "type": "string" },
    "fulfillment_status": { "type": ["string", "null"] },
    "financial_status": { "type": ["string", "null"] },
    "customer_email": { "type": ["string", "null"], "format": "email" },
    "currency": { "type": "string", "default": "USD" },
    "totals": {
      "type": "object",
      "additionalProperties": true
    },
    "line_items": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "raw": { "type": "object", "additionalProperties": true },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
