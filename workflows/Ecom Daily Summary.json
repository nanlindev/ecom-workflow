{
  "name": "Ecom Daily Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 9
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "id": "e468352f-9954-4461-9977-e95503c69897",
      "name": "Daily 9am",
      "notes": "Daily 09:00 UTC ops digest.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst crypto = require('crypto');\nconst item = $input.item.json || {};\nreturn {\n  period: 'daily',\n  store_id: item.store_id || $env.ECOM_DEMO_STORE_ID || null,\n  store_key: item.store_key || $env.ECOM_DEMO_STORE_KEY || 'demo-shopify',\n  correlation_id: item.correlation_id || crypto.randomUUID(),\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "id": "4d677258-e89f-4ef7-b890-3d749128c0e7",
      "name": "Prepare Summary Body",
      "notes": "period=daily; store from env when unset.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ecom_python_ai:8001/ops/summary",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ period: $json.period, store_id: $json.store_id || null, store_key: $json.store_key || null, correlation_id: $json.correlation_id }) }}",
        "options": {
          "timeout": 45000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Correlation-Id",
              "value": "={{ $json.correlation_id }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        440,
        0
      ],
      "id": "5c1a28db-fde9-4d24-9776-ec2f9ff0b415",
      "name": "Sidecar Ops Summary",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput",
      "notes": "Aggregate orders/returns/pricing/errors for digest.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item;\nconst errJson = item.json || {};\nconst errorObj = item.error || errJson.error || {};\nconst errorMessage =\n  errorObj.message ||\n  errorObj.description ||\n  errJson.message ||\n  errJson.description ||\n  (typeof errJson.error === 'string' ? errJson.error : null) ||\n  'Ops summary sidecar failed';\n\nconst prep = $('Prepare Summary Body').item.json;\nreturn {\n  ...prep,\n  ok: false,\n  should_alert_slack: false,\n  summary_error_message: errorMessage,\n  slack_text: `Ecom summary failed: ${errorMessage}`,\n  _metadata: { processing_stage: 'ops_summary_failed', severity: 'high' },\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        200
      ],
      "id": "515f9305-da7f-4178-a074-7a2e0311d2ea",
      "name": "Handle Summary HTTP Error"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst prep = $('Prepare Summary Body').item.json;\nconst res = $input.item.json || {};\nconst body = res.body && typeof res.body === 'object' ? res.body : res;\nreturn {\n  ...prep,\n  ...body,\n  correlation_id: body.correlation_id || prep.correlation_id,\n  should_alert_slack: body.should_alert_slack === true,\n  slack_text: body.slack_text || `Ecom ${prep.period} summary`,\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "id": "c2861eeb-bf17-4dbb-9db7-8eda5d9dab23",
      "name": "Flatten Summary Result"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "34482982-cf80-4b60-bdd2-281fc2a71140",
              "leftValue": "={{ $json.should_alert_slack }}",
              "rightValue": "true",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        0
      ],
      "id": "f04c4915-5258-4291-9032-02996ffb4e8c",
      "name": "Should Send Daily?"
    },
    {
      "parameters": {
        "authentication": "accessToken",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.SLACK_ECOM_CHANNEL_ID || 'SLACK_ECOM_CHANNEL_ID' }}"
        },
        "text": "={{ $json.slack_text }}"
      },
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        1100,
        -80
      ],
      "id": "72d02865-26bb-44e3-a4c7-c3f2383cd0ba",
      "name": "Slack Daily Summary",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput",
      "credentials": {
        "slackApi": {
          "id": "SLACK_BOT_CREDENTIAL_ID",
          "name": "Slack ecom bot"
        }
      },
      "notes": "Bind Slack API Access Token = Bot User OAuth Token (xoxb-). Do not use OAuth2.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item;\nconst errJson = item.json || {};\nconst errorObj = item.error || errJson.error || {};\nconst errorMessage =\n  errorObj.message ||\n  errorObj.description ||\n  errJson.message ||\n  errJson.description ||\n  (typeof errJson.error === 'string' ? errJson.error : null) ||\n  'Slack daily summary failed';\n\nconst prev = $('Flatten Summary Result').item.json;\nreturn { ...prev, slack_failed: true, slack_error_message: errorMessage };\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        40
      ],
      "id": "f58de249-3cd9-4c14-9303-a8e1499f15ab",
      "name": "Log Slack Daily Error"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1100,
        160
      ],
      "id": "66e83136-9d1a-4fae-8b9b-eb66bf3bfe40",
      "name": "Skip Daily Slack"
    }
  ],
  "connections": {
    "Daily 9am": {
      "main": [
        [
          {
            "node": "Prepare Summary Body",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Summary Body": {
      "main": [
        [
          {
            "node": "Sidecar Ops Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sidecar Ops Summary": {
      "main": [
        [
          {
            "node": "Flatten Summary Result",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Handle Summary HTTP Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Handle Summary HTTP Error": {
      "main": [
        [
          {
            "node": "Flatten Summary Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Flatten Summary Result": {
      "main": [
        [
          {
            "node": "Should Send Daily?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Should Send Daily?": {
      "main": [
        [
          {
            "node": "Slack Daily Summary",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Skip Daily Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Slack Daily Summary": {
      "main": [
        [],
        [
          {
            "node": "Log Slack Daily Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": "Ecom Error Handler"
  },
  "tags": [
    {
      "name": "ecom-workflow"
    }
  ],
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
