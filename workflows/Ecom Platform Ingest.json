      "notes": "Shopify webhook ingress; rawBody required for HMAC verification.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst crypto = require('crypto');\nconst item = $input.item.json || {};\nconst headers = item.headers || {};\nconst rawBody =\n  item.rawBody ||\n  (typeof item.body === 'string' ? item.body : JSON.stringify(item.body ?? item));\n\nconst correlation_id =\n  headers['x-correlation-id'] ||\n  headers['X-Correlation-Id'] ||\n  crypto.randomUUID();\n\nconst store_key =\n  $env.ECOM_DEMO_STORE_KEY ||\n  (headers['x-shopify-shop-domain'] || '').replace('.myshopify.com', '') ||\n  'demo-shopify';\n\nreturn {\n  correlation_id,\n  store_key,\n  raw_body: rawBody,\n  headers,\n  skip_verify: false,\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "id": "4f93eef7-d805-4b7f-a45d-44918614576a",
      "name": "Prepare Ingest Request",
      "notes": "Assign correlation_id early; forward raw body + headers for HMAC.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ecom_python_ai:8001/ingest/shopify",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ raw_body: $json.raw_body, headers: $json.headers, store_key: $json.store_key, correlation_id: $json.correlation_id, skip_verify: $json.skip_verify }) }}",
        "options": {
          "timeout": 45000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Correlation-Id",
              "value": "={{ $json.correlation_id }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        440,
        0
      ],
      "id": "1ecbdcd6-fe61-44f0-8399-b07fe4f487ac",
      "name": "Sidecar Ingest Shopify",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput",
      "notes": "Verify HMAC → normalize → idempotent PG upsert.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item;\nconst errJson = item.json || {};\nconst errorObj = item.error || errJson.error || {};\nconst errorMessage =\n  errorObj.message ||\n  errorObj.description ||\n  errJson.message ||\n  errJson.description ||\n  (typeof errJson.error === 'string' ? errJson.error : null) ||\n  'Ingest sidecar call failed';\n\nconst prep = $('Prepare Ingest Request').item.json;\nreturn {\n  ...prep,\n  ok: false,\n  signature_valid: false,\n  ingest_error_message: errorMessage,\n  http_status: 502,\n  dispatch: { inventory: false, order: false, returns: false },\n  _metadata: { processing_stage: 'ingest_http_failed', severity: 'high' },\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        200
      ],
      "id": "ac725615-c9c8-4a01-9806-85ef5d9a80c2",
      "name": "Handle Ingest HTTP Error"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst prep = $('Prepare Ingest Request').item.json;\nconst res = $input.item.json || {};\nconst body = res.body && typeof res.body === 'object' ? res.body : res;\nconst eventType = body.event_type || '';\nconst primary = body.entities?.primary_id || '';\nreturn {\n  ...prep,\n  ...body,\n  correlation_id: body.correlation_id || prep.correlation_id,\n  signature_valid: body.signature_valid !== false && body.ok !== false,\n  dispatch: body.dispatch || { inventory: false, order: false, returns: false },\n  sku: body.entities?.sku || '',\n  order_id: eventType === 'order' ? primary : '',\n  return_id: eventType === 'return' ? primary : '',\n  external_order_id: body.entities?.external_order_id || '',\n  external_return_id: body.entities?.external_return_id || '',\n  amount: body.entities?.amount ?? null,\n  days_since_order: Number(body.days_since_order ?? 0),\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
