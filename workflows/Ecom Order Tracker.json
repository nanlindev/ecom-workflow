{
  "name": "Ecom Order Tracker",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "store_id"
            },
            {
              "name": "order_id"
            },
            {
              "name": "external_order_id"
            },
            {
              "name": "new_status"
            },
            {
              "name": "correlation_id"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "id": "c3833349-cdc5-4b90-b9b7-6d1f201838ae",
      "name": "When Executed by Another Workflow"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst item = $input.item.json || {};\nreturn {\n  store_id: item.store_id,\n  order_id: item.order_id || null,\n  external_order_id: item.external_order_id || null,\n  new_status: item.new_status || null,\n  correlation_id: item.correlation_id || '',\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "id": "19ac49ea-3085-4d61-9455-f1c519cd4264",
      "name": "Prepare Order Track Body"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ecom_python_ai:8001/orders/track",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ store_id: $json.store_id, order_id: $json.order_id || null, external_order_id: $json.external_order_id || null, new_status: $json.new_status || null, correlation_id: $json.correlation_id }) }}",
        "options": {
          "timeout": 45000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Correlation-Id",
              "value": "={{ $json.correlation_id }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        440,
        0
      ],
      "id": "71f81ce5-81c0-4e63-80d7-32a98320af0d",
      "name": "Sidecar Order Track",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput",
      "notes": "Status machine + anomaly heuristics.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item;\nconst errJson = item.json || {};\nconst errorObj = item.error || errJson.error || {};\nconst errorMessage =\n  errorObj.message ||\n  errorObj.description ||\n  errJson.message ||\n  errJson.description ||\n  (typeof errJson.error === 'string' ? errJson.error : null) ||\n  'Order track sidecar failed';\n\nconst prep = $('Prepare Order Track Body').item.json;\nreturn {\n  ...prep,\n  ok: false,\n  is_anomaly: false,\n  should_alert_slack: false,\n  order_error_message: errorMessage,\n  _metadata: { processing_stage: 'order_track_failed', severity: 'high' },\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        200
      ],
      "id": "129649c1-3141-4016-8e43-486dfa8e7ada",
      "name": "Handle Order HTTP Error"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst prep = $('Prepare Order Track Body').item.json;\nconst res = $input.item.json || {};\nconst body = res.body && typeof res.body === 'object' ? res.body : res;\nconst reasons = body.anomaly_reasons || [];\nreturn {\n  ...prep,\n  ...body,\n  correlation_id: body.correlation_id || prep.correlation_id,\n  slack_text: [\n    '⚠️ Order anomaly',\n    `Order: ${body.external_order_id || body.order_id}`,\n    `Status: ${body.previous_status || '?'} → ${body.status || '?'}`,\n    `Reasons: ${reasons.join(', ') || 'n/a'}`,\n    `Correlation: ${body.correlation_id || prep.correlation_id}`,\n  ].join('\\n'),\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "id": "87d32340-68e5-40c8-b010-0ec92a2f4c74",
      "name": "Flatten Order Result"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "a9eced95-f6ee-4ca7-b52d-dae8191b1b46",
              "leftValue": "={{ $json.should_alert_slack }}",
              "rightValue": "true",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        0
      ],
      "id": "c595eb3c-4b35-4c52-9f45-8b5adba0b42b",
      "name": "Should Alert Anomaly?"
    },
    {
      "parameters": {
        "authentication": "accessToken",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.SLACK_ECOM_CHANNEL_ID || 'SLACK_ECOM_CHANNEL_ID' }}"
        },
        "text": "={{ $json.slack_text }}"
      },
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        1100,
        0
      ],
      "id": "40fdb0fe-89a9-42e3-84af-9b995f7ea3ba",
      "name": "Slack Order Anomaly",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput",
      "credentials": {
        "slackApi": {
          "id": "SLACK_BOT_CREDENTIAL_ID",
          "name": "Slack ecom bot"
        }
      },
      "notes": "Bind Slack API Access Token = Bot User OAuth Token (xoxb-). Do not use OAuth2.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item;\nconst errJson = item.json || {};\nconst errorObj = item.error || errJson.error || {};\nconst errorMessage =\n  errorObj.message ||\n  errorObj.description ||\n  errJson.message ||\n  errJson.description ||\n  (typeof errJson.error === 'string' ? errJson.error : null) ||\n  'Slack order alert failed';\n\nconst prev = $('Flatten Order Result').item.json;\nreturn { ...prev, slack_failed: true, slack_error_message: errorMessage };\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        120
      ],
      "id": "ffaf3b30-1356-41f8-a172-9c38c0786bb4",
      "name": "Log Slack Order Error"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1100,
        200
      ],
      "id": "1ef8fe29-6f44-42d0-a3ed-14ff3f59d132",
      "name": "No Order Alert"
    }
  ],
  "connections": {
    "When Executed by Another Workflow": {
