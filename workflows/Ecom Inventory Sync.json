          }
        ]
      ]
    },
    "Merge Inventory Triggers": {
      "main": [
        [
          {
            "node": "Prepare Inventory Sync Body",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Inventory Sync Body": {
      "main": [
        [
          {
