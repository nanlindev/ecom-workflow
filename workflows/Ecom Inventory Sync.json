{
  "name": "Ecom Inventory Sync",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "store_id"
            },
            {
              "name": "store_key"
            },
            {
              "name": "sku"
            },
            {
              "name": "correlation_id"
            },
            {
              "name": "slave_levels"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "id": "64b1ee40-4f75-4ee9-9333-0270b056e5c5",
      "name": "When Executed by Another Workflow"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        220
      ],
      "id": "29635ef9-e9b7-4e6f-a2a5-86564ad717a6",
      "name": "Inventory Reconcile Cron",
      "notes": "Periodic inventory reconciliation when webhooks are missed.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nreturn {\n  store_id: $env.ECOM_DEMO_STORE_ID || '',\n  store_key: $env.ECOM_DEMO_STORE_KEY || 'demo-shopify',\n  sku: '',\n  correlation_id: require('crypto').randomUUID(),\n  slave_levels: [],\n  trigger_source: 'cron',\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        220
      ],
      "id": "c762bae0-8b33-490a-9030-1c9b58660f2a",
      "name": "Cron Seed Payload"
    },
    {
      "parameters": {
        "mode": "append",
        "options": {}
      },
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        440,
        80
      ],
      "id": "ea572eb5-dde5-4993-a89b-30b3ab97d858",
      "name": "Merge Inventory Triggers",
      "notes": "Merge multi-source inventory observations before master conflict resolution.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst item = $input.item.json || {};\nconst slave = item.slave_levels;\nlet slave_levels = [];\nif (Array.isArray(slave)) slave_levels = slave;\nelse if (typeof slave === 'string' && slave.trim()) {\n  try { slave_levels = JSON.parse(slave); } catch { slave_levels = []; }\n}\nreturn {\n  store_id: item.store_id || null,\n  store_key: item.store_key || null,\n  sku: item.sku || null,\n  correlation_id: item.correlation_id || '',\n  slave_levels: slave_levels.length ? slave_levels : null,\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        80
      ],
      "id": "d8a162e1-8c32-4970-8eb8-4853ba84b80b",
      "name": "Prepare Inventory Sync Body",
      "notes": "Normalize Execute/Cron payload; optional slave_levels from Merge upstream.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ecom_python_ai:8001/inventory/sync",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ store_id: $json.store_id || null, store_key: $json.store_key || null, sku: $json.sku || null, correlation_id: $json.correlation_id, slave_levels: $json.slave_levels }) }}",
        "options": {
          "timeout": 45000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Correlation-Id",
              "value": "={{ $json.correlation_id }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        880,
        80
      ],
      "id": "d7b5a242-3726-41b8-8610-248d37307227",
      "name": "Sidecar Inventory Sync",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput",
      "notes": "Master wins; live writeback if creds else SoT-only.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item;\nconst errJson = item.json || {};\nconst errorObj = item.error || errJson.error || {};\nconst errorMessage =\n  errorObj.message ||\n  errorObj.description ||\n  errJson.message ||\n  errJson.description ||\n  (typeof errJson.error === 'string' ? errJson.error : null) ||\n  'Inventory sync sidecar failed';\n\nconst prep = $('Prepare Inventory Sync Body').item.json;\nreturn {\n  ...prep,\n  ok: false,\n  has_drift: false,\n  should_alert_slack: false,\n  writeback_status: 'failed',\n  inventory_error_message: errorMessage,\n  _metadata: { processing_stage: 'inventory_sync_failed', severity: 'high' },\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        260
      ],
      "id": "a47b1d16-263c-453d-a746-3e11f4915dd5",
      "name": "Handle Inventory HTTP Error"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst prep = $('Prepare Inventory Sync Body').item.json;\nconst res = $input.item.json || {};\nconst body = res.body && typeof res.body === 'object' ? res.body : res;\nconst drifts = body.drifts || [];\nconst channels = (body.channel_writebacks || [])\n  .map(c => `${c.slave_channel || c.channel}=${c.live_status || 'n/a'}`)\n  .slice(0, 5)\n  .join(', ');\nreturn {\n  ...prep,\n  ...body,\n  correlation_id: body.correlation_id || prep.correlation_id,\n  slack_text: [\n    '📦 Inventory drift detected',\n    `Store: ${body.store_id || prep.store_id}`,\n    `Master: ${body.master_channel || 'shopify'}`,\n    `Drifts: ${drifts.length}`,\n    drifts.slice(0, 5).map(d => `${d.sku}: ${d.slave_channel}=${d.slave_available} vs master=${d.master_available}`).join('\\n'),\n    `Writeback: ${body.writeback_status || 'n/a'}${channels ? ` (${channels})` : ''}`,\n    `Correlation: ${body.correlation_id || prep.correlation_id}`,\n  ].filter(Boolean).join('\\n'),\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        80
      ],
      "id": "da298804-931a-476d-b412-b06407757816",
      "name": "Flatten Inventory Result"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "d2d28532-3867-4d97-a962-2d40f38303d4",
              "leftValue": "={{ $json.should_alert_slack }}",
              "rightValue": "true",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1320,
        80
      ],
      "id": "7c2d2950-3f26-4390-ad9f-251046375623",
      "name": "Should Alert Drift?"
    },
    {
      "parameters": {
        "authentication": "accessToken",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.SLACK_ECOM_CHANNEL_ID || 'SLACK_ECOM_CHANNEL_ID' }}"
        },
        "text": "={{ $json.slack_text }}"
      },
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        1540,
        0
      ],
      "id": "289182db-3b64-4bdf-84ac-9d4ea7f5bb44",
      "name": "Slack Inventory Drift",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput",
      "credentials": {
        "slackApi": {
          "id": "SLACK_BOT_CREDENTIAL_ID",
          "name": "Slack ecom bot"
        }
      },
      "notes": "Bind Slack API Access Token = Bot User OAuth Token (xoxb-). Do not use OAuth2.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item;\nconst errJson = item.json || {};\nconst errorObj = item.error || errJson.error || {};\nconst errorMessage =\n  errorObj.message ||\n  errorObj.description ||\n  errJson.message ||\n  errJson.description ||\n  (typeof errJson.error === 'string' ? errJson.error : null) ||\n  'Slack drift alert failed';\n\nconst prev = $('Flatten Inventory Result').item.json;\nreturn { ...prev, slack_failed: true, slack_error_message: errorMessage };\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        120
      ],
      "id": "308e272c-b343-4e2c-b7bd-faa90ce2a63e",
      "name": "Log Slack Drift Error"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1540,
        200
      ],
      "id": "f6bd54d2-28d0-4203-a5e2-24cbc33f1641",
      "name": "No Drift Alert"
    }
  ],
  "connections": {
    "When Executed by Another Workflow": {
