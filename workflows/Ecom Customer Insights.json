{
  "name": "Ecom Customer Insights",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "id": "74a571ca-8de2-42de-96ea-87416c817aa5",
      "name": "Customer Insights Cron",
      "notes": "Periodic inventory reconciliation when webhooks are missed.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nreturn {\n  store_id: $env.ECOM_DEMO_STORE_ID || '',\n  correlation_id: require('crypto').randomUUID(),\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "id": "bdfbd692-75bc-493f-b04e-dc71d40b367b",
      "name": "Insights Seed"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ecom_python_ai:8001/insights/rfm",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ store_id: $json.store_id, correlation_id: $json.correlation_id }) }}",
        "options": {
          "timeout": 45000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Correlation-Id",
              "value": "={{ $json.correlation_id }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        440,
        0
      ],
      "id": "84119e5d-70e7-453a-b338-a5d583cf04aa",
      "name": "Sidecar RFM",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item;\nconst errJson = item.json || {};\nconst errorObj = item.error || errJson.error || {};\nconst errorMessage =\n  errorObj.message ||\n  errorObj.description ||\n  errJson.message ||\n  errJson.description ||\n  (typeof errJson.error === 'string' ? errJson.error : null) ||\n  'Insights RFM failed';\n\nconst prep = $('Insights Seed').first()?.json || {};\nreturn { ...prep, ok: false, rfm_error_message: errorMessage, _metadata: { processing_stage: 'insights_rfm_error', severity: 'medium', error_message: errorMessage } };\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        160
      ],
      "id": "5ddfd412-4d18-412a-b499-12804a6b40d9",
      "name": "Handle RFM HTTP Error"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ecom_python_ai:8001/insights/churn",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ store_id: $('Insights Seed').item.json.store_id, correlation_id: $('Insights Seed').item.json.correlation_id }) }}",
        "options": {
          "timeout": 45000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Correlation-Id",
              "value": "={{ $json.correlation_id }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        660,
        0
      ],
      "id": "d9984799-79b0-48be-9c8e-377918fe0515",
      "name": "Sidecar Churn",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item;\nconst errJson = item.json || {};\nconst errorObj = item.error || errJson.error || {};\nconst errorMessage =\n  errorObj.message ||\n  errorObj.description ||\n  errJson.message ||\n  errJson.description ||\n  (typeof errJson.error === 'string' ? errJson.error : null) ||\n  'Insights churn failed';\n\nconst prep = $('Insights Seed').first()?.json || {};\nreturn { ...prep, ok: false, churn_error_message: errorMessage, _metadata: { processing_stage: 'insights_churn_error', severity: 'medium', error_message: errorMessage } };\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        160
      ],
      "id": "8e739ad8-0e0c-4a81-9d7d-ea8fdc70a5f6",
      "name": "Handle Churn HTTP Error"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        880,
        0
      ],
      "id": "21cadca6-a572-45bd-9df8-d5a4b0e336fe",
      "name": "Insights Done"
    }
  ],
  "connections": {
    "Customer Insights Cron": {
      "main": [
        [
          {
            "node": "Insights Seed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Insights Seed": {
      "main": [
        [
          {
            "node": "Sidecar RFM",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sidecar RFM": {
      "main": [
        [
          {
            "node": "Sidecar Churn",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Handle RFM HTTP Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Handle RFM HTTP Error": {
      "main": [
        [
          {
            "node": "Insights Done",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sidecar Churn": {
      "main": [
        [
          {
            "node": "Insights Done",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Handle Churn HTTP Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Handle Churn HTTP Error": {
      "main": [
        [
          {
            "node": "Insights Done",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": "Ecom Error Handler"
  },
  "tags": [
    {
      "name": "ecom-workflow"
    }
  ],
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
